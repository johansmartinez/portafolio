---
import './footer.css';
import Socialmedia from './socialmedia.astro';

const socialMedia=[
    {
        name:"git",
        url: "https://github.com/johansmartinez",
        image:"/img/github.svg",
        label:"@johansmartinez",
    },
    {
        name:"mail",
        url: "mailto:johan.martinez.dev@gmail.com",
        image:"/img/mail.svg",
        label:"johan.martinez.dev@gmail.com",
    },
    {
        name:"linkedin",
        url: "https://www.linkedin.com/in/johan-sebastian-martinez-junco-dev/",
        image:"/img/linkedin.svg",
        label:"Johan Martinez",
    },
];
---

<footer id='contact'>
    <div class='div-name'>
        <p class='big-p'>Johan Martínez</p>
    </div>
    <div class='div-links'>
        {
            socialMedia.map(s=> 
            <Socialmedia name={s.name} image={s.image} label={s.label} url={s.url}/>
            )
        }
    </div>
</footer>