---
import { Image } from 'astro:assets';
import './footer.css';

interface Props {
    name:string;
    url: string;
    image:string;
    label:string;
}

const {
    name,
    url,
    image,
    label,
}=Astro.props;
---
<a target="_blank" rel='noreferrer' class={`footer-contact ${name}`} href={url}>
    <Image width="100" height="100" class="footer-icon" src={image} alt={`Logo ${name}`} />
    <span class='span-contact'>{label}</span>
</a>